{
  "name": "nyaya_flow-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "NyayaFlow Unified Workspace (Frontend Next.js + Backend Express/FastAPI)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "npx concurrently -k \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "postinstall": "npm --prefix frontend install",
    "lint": "npm --prefix frontend run lint"
  }
}
