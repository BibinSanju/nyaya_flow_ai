# =============================================================================
# NyayaFlow frontend configuration
# Copy to frontend/.env for local development. On Vercel, set under
# Project → Settings → Environment Variables.
# =============================================================================

# Backend URL, no trailing slash. Locally: http://127.0.0.1:5000
# On Vercel: your Render URL, e.g. https://nyayaflow-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
