# =============================================================================
# NyayaFlow backend configuration
# Copy to backend/.env for local development. On Render, set these under
# Service → Environment.
# =============================================================================

PORT=5000
NODE_ENV=development

# Long random string used to sign sessions and hash sign-in codes. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase → Project Settings → API
# Use the SERVICE ROLE key (secret), NOT the anon/public key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to "documents"
SUPABASE_STORAGE_BUCKET=documents

# Your frontend URL(s), comma separated, no trailing slash
CORS_ORIGIN=http://localhost:3000

# Groq (AI assistant and speech-to-text) — https://console.groq.com/keys
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Email for sign-in codes. Render's free tier blocks SMTP, so use Brevo.
# Brevo: brevo.com → Settings → Senders (verify your sender email)
#        → SMTP & API → API keys → Generate
# -----------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=you@gmail.com
EMAIL_FROM_NAME=NyayaFlow

# Optional alternatives (tried after Brevo, in this order)
# RESEND_API_KEY=          # needs a domain you own, verified in Resend
# SMTP_HOST=smtp.gmail.com # local development only; blocked on Render free tier
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=               # Gmail App Password (16 characters)

OTP_EXPIRY_MINUTES=10

# -----------------------------------------------------------------------------
# Accounts
# Citizens and advocates sign up themselves. Police, registry and judge accounts
# must be added to the users table first (see db/security.sql).
# -----------------------------------------------------------------------------
# Emails allowed to create an administrator account on first sign-in
ADMIN_EMAILS=
# Set to true only for demos: lets anyone create police/registry/judge accounts
ALLOW_OFFICIAL_SIGNUP=false
